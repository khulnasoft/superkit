package auth

import "github.com/khulnasoft/superkit/bootstrap/app/views/layouts"

type AdminPageData struct {
    User Auth
}

templ AdminIndex(data AdminPageData) {
    @layouts.App() {
        <div class="mt-12 flex flex-col gap-8">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm uppercase tracking-wider text-muted-foreground">Admin</p>
                    <h1 class="text-4xl font-semibold">Dashboard</h1>
                </div>
                <a href="/profile" class="rounded-md border px-4 py-2 text-sm">Back to profile</a>
            </div>
            <div class="grid gap-4 md:grid-cols-3">
                <div class="rounded-lg border p-6">
                    <p class="text-sm text-muted-foreground">Visible users</p>
                    <p class="mt-2 text-3xl font-semibold">42</p>
                </div>
                <div class="rounded-lg border p-6">
                    <p class="text-sm text-muted-foreground">Active sessions</p>
                    <p class="mt-2 text-3xl font-semibold">18</p>
                </div>
                <div class="rounded-lg border p-6">
                    <p class="text-sm text-muted-foreground">Status</p>
                    <p class="mt-2 text-3xl font-semibold">Healthy</p>
                </div>
            </div>
            <div class="rounded-lg border p-6">
                <p class="text-sm text-muted-foreground">Signed in as</p>
                <p class="mt-2 text-xl font-medium">{ data.User.Email }</p>
            </div>
        </div>
    }
}

templ AdminAccessDenied() {
    @layouts.App() {
        <div class="mt-20 max-w-lg rounded-lg border border-red-200 bg-red-50 p-8 dark:border-red-900 dark:bg-red-950/20">
            <p class="text-sm uppercase tracking-wider text-red-600">Access denied</p>
            <h2 class="mt-3 text-2xl font-semibold">You do not have admin access.</h2>
            <p class="mt-3 text-sm text-muted-foreground">This account is not authorized to view the admin dashboard.</p>
        </div>
    }
}
